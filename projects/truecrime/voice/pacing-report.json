    "segments": [
      {
        "index": 1,
        "text": "The night shift at the downtown precinct began like any other, until the call came in at 2:17 a.m.",
        "kind": "paragraph",
        "words": 19,
        "pauseAfterMs": 1240
      },
      {
        "index": 2,
        "text": "A body was found behind the old textile mill on River Street. No wallet. No phone.",
        "kind": "sentence",
        "words": 16,
        "pauseAfterMs": 500
      },
      {
        "index": 3,
        "text": "Just a single red scarf tied in a bow around the victim's neck.",
        "kind": "paragraph",
        "words": 13,
        "pauseAfterMs": 1230
      },
      {
        "index": 4,
        "text": "Detective Mara Voss arrived first. She walked the scene once, slowly, and said nothing.",
        "kind": "sentence",
        "words": 14,
        "pauseAfterMs": 500
      },
      {
        "index": 5,
        "text": "The rain had washed away most of the evidence, but not everything.",
        "kind": "paragraph",
        "words": 12,
        "pauseAfterMs": 1230
      },
      {
        "index": 6,
        "text": "Security footage from a bodega two blocks away showed a figure in a dark coat, limping, heading west at exactly 1:44 a.m.",
        "kind": "sentence",
        "words": 22,
        "pauseAfterMs": 500
      },
      {
        "index": 7,
        "text": "The timestamp matched the estimated time of death.",
        "kind": "paragraph",
        "words": 8,
        "pauseAfterMs": 1240
      },
      {
        "index": 8,
        "text": "Forensics recovered one partial print. It belonged to a man reported missing three weeks earlier. A man with no known enemies.",
        "kind": "sentence",
        "words": 21,
        "pauseAfterMs": 500
      },
      {
        "index": 9,
        "text": "A man who, according to his coworkers, simply stopped coming to work one Tuesday and was never seen again.",
        "kind": "paragraph",
        "words": 19,
        "pauseAfterMs": 1230
      },
      {
        "index": 10,
        "text": "The case went cold. Until last week, when an identical red scarf turned up in a donation bin outside the precinct.",
        "kind": "paragraph",
        "words": 21,
        "pauseAfterMs": 1230
      },
      {
        "index": 11,
        "text": "Someone knows what happened that night. And they are watching.",
        "kind": "paragraph",
        "words": 10,
        "pauseAfterMs": 0
      }
    ]
  }
}